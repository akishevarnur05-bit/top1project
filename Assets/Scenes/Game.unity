MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2041277605}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7135a8f90f629974bb82dcaf4bec2e46, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CyberDefender.Tower.TowerManager
  floors:
  - title: Boot Sector
    level: {fileID: 11400000, guid: ad5d91afefaf2c941a93e517dc052116, type: 2}
    viruses:
    - {fileID: 11400000, guid: 5aab08a1a68233a4995c05448710581c, type: 2}
    introLines:
    - "\u041F\u0441-\u0441... \u0410\u043D\u0442\u0438\u0432\u0438\u0440\u0443\u0441? \u0417\u0434\u0435\u0441\u044C? \u0412 \u0437\u0430\u0433\u0440\u0443\u0437\u043E\u0447\u043D\u043E\u043C \u0441\u0435\u043A\u0442\u043E\u0440\u0435?"
    - "\u042F \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u0431\u0435\u0437\u043E\u0431\u0438\u0434\u043D\u044B\u0439 setup.exe. \u0427\u0435\u0441\u0442\u043D\u043E-\u0447\u0435\u0441\u0442\u043D\u043E."
    - "...\u041B\u0430\u0434\u043D\u043E. \u0420\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u044E \u043F\u043E\u043B\u0435\u0437\u043D\u0443\u044E \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443!"
  - title: Memory Heap
    level: {fileID: 11400000, guid: 1acb2a97eef914345bc93f938f8f4507, type: 2}
    viruses:
    - {fileID: 11400000, guid: 5aab08a1a68233a4995c05448710581c, type: 2}
    - {fileID: 11400000, guid: 5aab08a1a68233a4995c05448710581c, type: 2}
    introLines:
    - "\u041F\u043E\u043A\u0430 \u0442\u044B \u043F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0436\u0430\u043B\u0441\u044F, \u043C\u044B \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C. \u041D\u0430\u0441 \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0432\u043E\u0435."
    - "\u0412\u0441\u044F \u044D\u0442\u0430 \u043F\u0430\u043C\u044F\u0442\u044C \u2014 \u043D\u0430\u0448\u0430. Malloc, malloc, malloc!"
  - title: File System
    level: {fileID: 11400000, guid: 13d34f52214e9e946aa5f4a2f477a7a7, type: 2}
    viruses:
    - {fileID: 11400000, guid: 2a0e03454b573c349ae85b932350ca61, type: 2}
    introLines:
    - "\u0422\u0432\u043E\u0438 \u0444\u0430\u0439\u043B\u044B? \u0411\u044B\u043B\u0438 \u0442\u0432\u043E\u0438."
    - "\u0412\u0441\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u044B \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u044B. \u041A\u043B\u044E\u0447 \u2014 \u043F\u043E\u043B\u0431\u0438\u0442\u043A\u043E\u0438\u043D\u0430."
    - "\u041D\u0435 \u0445\u043E\u0447\u0435\u0448\u044C \u043F\u043B\u0430\u0442\u0438\u0442\u044C? \u0422\u043E\u0433\u0434\u0430 \u044F \u0437\u0430\u0448\u0438\u0444\u0440\u0443\u044E \u0438 \u0442\u0435\u0431\u044F."
  - title: Driver Stack
    level: {fileID: 11400000, guid: b242e77d99a21294a81e84ea815a6729, type: 2}
    viruses:
    - {fileID: 11400000, guid: 2a0e03454b573c349ae85b932350ca61, type: 2}
    - {fileID: 11400000, guid: 5aab08a1a68233a4995c05448710581c, type: 2}
    introLines:
    - "\u042F \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B\u0441\u044F \u043A\u0430\u043A \u0434\u0440\u0430\u0439\u0432\u0435\u0440 \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u044B. \u041D\u0438\u043A\u0442\u043E \u0434\u0430\u0436\u0435 \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B."
    - "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u2014 ring 0. \u0423\u0440\u043E\u0432\u0435\u043D\u044C \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044F \u2014 \u043D\u043E\u043B\u044C."
  - title: KERNEL CORE
    level: {fileID: 11400000, guid: f653c03af24ce8a43be29efa4ea38dc4, type: 2}
    viruses:
    - {fileID: 11400000, guid: ee1833559aca91644aed0153dd615cd9, type: 2}
    introLines:
    - "\u0422\u044B \u0434\u043E\u0448\u0451\u043B \u0434\u043E \u044F\u0434\u0440\u0430. \u0412\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u0435\u0442... \u0434\u043B\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430 \u0431\u0435\u0437 \u043F\u0440\u0430\u0432 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440\u0430."
    - "\u042F \u0437\u0434\u0435\u0441\u044C \u0441 \u0441\u0430\u043C\u043E\u0439 \u043F\u0435\u0440\u0432\u043E\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438. \u042F \u2014 \u043A\u0430\u0436\u0434\u044B\u0439 \u0442\u0432\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0439 \u0432\u044B\u0437\u043E\u0432."
    - "\u0414\u0438\u0441\u043F\u0435\u0442\u0447\u0435\u0440 \u0437\u0430\u0434\u0430\u0447 \u043C\u0435\u043D\u044F \u043D\u0435 \u0432\u0438\u0434\u0438\u0442. \u0421\u043A\u043E\u0440\u043E \u043E\u043D \u043D\u0435 \u0443\u0432\u0438\u0434\u0438\u0442 \u0438 \u0442\u0435\u0431\u044F."
